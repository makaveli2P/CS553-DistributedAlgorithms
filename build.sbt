import org.scalajs.linker.interface.{ModuleKind, ModuleSplitStyle}
import org.typelevel.scalacoptions.ScalacOptions

// ---------------------------------------------------------------------------
// Akka token gating
//
// Akka 2.10 resolves only from https://repo.akka.io/<token>/secure.
// The build adds that resolver only when AKKA_REPO_TOKEN is set.
// Without the token, the root aggregate excludes `actors` and `cli`, so
// `core` and `web` build with no Akka account. Do not commit the token.
// ---------------------------------------------------------------------------
lazy val akkaRepoToken: Option[String] =
  sys.env.get("AKKA_REPO_TOKEN").map(_.trim).filter(_.nonEmpty)

lazy val akkaTokenMessage: String =
  "AKKA_REPO_TOKEN is not set: the build skips the modules `actors` and `cli`. " +
    "Get a free token at https://account.akka.io/token and export AKKA_REPO_TOKEN to build them."

ThisBuild / organization := "io.github.cs553"
ThisBuild / scalaVersion := Versions.scala3
ThisBuild / resolvers ++= akkaRepoToken.toSeq.map { token =>
  "Akka library repository".at(s"https://repo.akka.io/$token/secure")
}

// Scalafix for Scala 3 reads SemanticDB, which the compiler writes.
ThisBuild / semanticdbEnabled := true

Global / onLoad := {
  val previous = (Global / onLoad).value
  previous.andThen { state =>
    if (akkaRepoToken.isEmpty) { state.log.warn(akkaTokenMessage) }
    state
  }
}

// Without the token, a direct call such as `sbt actors/compile` stops in `update`
// with the same clear line, not with a raw download error.
lazy val akkaTokenGate: Seq[Setting[?]] =
  if (akkaRepoToken.isEmpty) { Seq(update := { throw new MessageOnlyException(akkaTokenMessage) }) }
  else { Seq.empty }

// Settings for every module. Compiler flags come only from sbt-tpolecat (coding rule 31).
lazy val commonSettings = Seq(
  // Coding rule 12: no implicit conversions.
  tpolecatExcludeOptions += ScalacOptions.languageImplicitConversions,
  Test / tpolecatExcludeOptions += ScalacOptions.warnNonUnitStatement
)

// Core does no IO, so the build embeds files from `fixtures` as generated Scala sources:
// the topologies in main code (the UI presets and the tests read them) and the golden traces in
// test code (the golden test reads them on the JVM and on JavaScript).
// Each file becomes a list of string chunks, because the JVM limits one string constant to 64 KiB.
def embedFiles(
    out: File,
    pkg: String,
    objectName: String,
    files: Seq[(String, File)]
): Seq[File] = {
  val quote = "\"\"\""
  val entries = files.sortBy(_._1).map { case (key, f) =>
    val text = IO.read(f)
    require(!text.contains(quote), s"${f.getName} contains a triple quote")
    val chunks = text.grouped(16000).map(c => "      " + quote + c + quote).mkString(",\n")
    "    (\"" + key + "\", List(\n" + chunks + "\n    ).mkString)"
  }
  val lines = Seq(
    s"package $pkg",
    "",
    "/** Generated by build.sbt from the files in fixtures. Do not edit. */",
    s"object $objectName {",
    "  val all: List[(String, String)] = List(",
    entries.mkString(",\n"),
    "  )",
    "}",
    ""
  )
  IO.write(out, lines.mkString("\n"))
  Seq(out)
}

lazy val topologySources = Def.task {
  val dir = (LocalRootProject / baseDirectory).value / "fixtures" / "topologies"
  val files = (dir * "*.dot").get.map(f => (f.getName, f))
  val out = (Compile / sourceManaged).value / "cs553" / "core" / "registry" / "TopologyFiles.scala"
  embedFiles(out, "cs553.core.registry", "TopologyFiles", files)
}

// The recorded Akka runs (seed 1) go into main code, so that the browser can replay them.
lazy val recordingSources = Def.task {
  val dir = (LocalRootProject / baseDirectory).value / "fixtures" / "traces"
  val files = (dir ** "*-akka-*-1.json").get.flatMap(f => IO.relativize(dir, f).map(k => (k, f)))
  val out = (Compile / sourceManaged).value / "cs553" / "core" / "registry" / "RecordingFiles.scala"
  embedFiles(out, "cs553.core.registry", "RecordingFiles", files)
}

lazy val goldenSources = Def.task {
  val dir = (LocalRootProject / baseDirectory).value / "fixtures" / "traces"
  val files = (dir ** "*.json").get.flatMap(f => IO.relativize(dir, f).map(k => (k, f)))
  val out = (Test / sourceManaged).value / "cs553" / "core" / "golden" / "GoldenFiles.scala"
  embedFiles(out, "cs553.core.golden", "GoldenFiles", files)
}

lazy val core = crossProject(JVMPlatform, JSPlatform)
  .crossType(CrossType.Full)
  .in(file("modules/core"))
  .settings(commonSettings)
  .settings(
    name := "cs553-core",
    libraryDependencies ++= Seq(
      Dependencies.circeCore.value,
      Dependencies.circeParser.value,
      Dependencies.scalatest.value,
      Dependencies.scalacheck.value,
      Dependencies.scalatestplusScalacheck.value
    ),
    Compile / sourceGenerators += topologySources.taskValue,
    Compile / sourceGenerators += recordingSources.taskValue,
    Test / sourceGenerators += goldenSources.taskValue
  )
  // GoldenPromote ends with a non-zero exit code on an error, so it runs in its own JVM.
  .jvmSettings(Test / run / fork := true)

lazy val coreJVM = core.jvm
lazy val coreJS = core.js

lazy val actors = project
  .in(file("modules/actors"))
  .dependsOn(coreJVM)
  .settings(commonSettings)
  .settings(akkaTokenGate)
  .settings(
    name := "cs553-actors",
    libraryDependencies ++= Seq(
      Dependencies.akkaActorTyped,
      Dependencies.akkaActorTestkitTyped,
      Dependencies.scalatest.value,
      Dependencies.logback % Test
    )
  )

lazy val cli = project
  .in(file("modules/cli"))
  // The test code of cli reads the golden cases from the test code of core (GoldenRecord).
  .dependsOn(actors, coreJVM % "test->test")
  .settings(commonSettings)
  .settings(akkaTokenGate)
  .settings(
    name := "cs553-cli",
    libraryDependencies ++= Seq(
      Dependencies.logback,
      Dependencies.akkaActorTestkitTyped,
      Dependencies.scalatest.value
    ),
    run / fork := true,
    // Paths on the command line are relative to the repository root.
    run / baseDirectory := (LocalRootProject / baseDirectory).value,
    // GoldenRecord ends with a non-zero exit code on an error, so it runs in its own JVM.
    Test / run / fork := true
  )

lazy val web = project
  .in(file("modules/web"))
  .enablePlugins(ScalaJSPlugin)
  .dependsOn(coreJS)
  .settings(commonSettings)
  .settings(
    name := "cs553-web",
    scalaJSUseMainModuleInitializer := true,
    // Vite (with @scala-js/vite-plugin-scalajs) loads the linker output as ES modules.
    scalaJSLinkerConfig ~= {
      _.withModuleKind(ModuleKind.ESModule)
        .withModuleSplitStyle(ModuleSplitStyle.SmallModulesFor(List("cs553.web")))
    },
    libraryDependencies ++= Seq(
      Dependencies.laminar.value,
      Dependencies.scalajsDom.value,
      Dependencies.scalatest.value
    )
  )

// Coding rule 30: only this task writes the golden traces in fixtures/traces.
// With AKKA_REPO_TOKEN, it also records each case with the mediated Akka engine (cli record).
lazy val goldenPromote =
  taskKey[Unit]("Simulates (and records in Akka) each golden case and writes it to fixtures/traces")

lazy val tokenFreeModules: Seq[ProjectReference] = Seq(coreJVM, coreJS, web)
lazy val akkaModules: Seq[ProjectReference] = Seq(actors, cli)

lazy val root = project
  .in(file("."))
  .aggregate((tokenFreeModules ++ akkaRepoToken.toSeq.flatMap(_ => akkaModules)): _*)
  .settings(
    name := "cs553",
    publish / skip := true,
    goldenPromote := Def.taskDyn {
      val root = (LocalRootProject / baseDirectory).value
      val simulate = (coreJVM / Test / runMain).toTask(s" cs553.core.golden.GoldenPromote $root")
      if (akkaRepoToken.isEmpty) {
        Def.task {
          simulate.value
          streams.value.log
            .warn(akkaTokenMessage + " goldenPromote did not record the Akka traces.")
        }
      } else {
        Def.sequential(simulate, (cli / Test / runMain).toTask(s" cs553.cli.GoldenRecord $root"))
      }
    }.value
  )
